# Public site URL (used for canonical, sitemap, Open Graph). Use HTTPS in production.
NEXT_PUBLIC_SITE_URL=https://smcreditconsult-bg.com

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
# Create at https://analytics.google.com → Admin → Data streams → Web
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Gmail account that sends consultation emails (usually the contact inbox).
GMAIL_USER=smcreditconsult@gmail.com

# Google Account → Security → 2-Step Verification → App passwords
# Create an app password and paste it here (16 characters, spaces optional).
GMAIL_APP_PASSWORD=
